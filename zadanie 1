from kafka import KafkaConsumer
import json
from collections import defaultdict, deque
from datetime import datetime

TOPIC = 'transactions'
BROKER = 'broker:9092'
WINDOW_SECONDS = 60
THRESHOLD = 3

consumer = KafkaConsumer(
    TOPIC,
    bootstrap_servers=BROKER,
    auto_offset_reset='latest',
    value_deserializer=lambda x: json.loads(x.decode('utf-8'))
)

print(f"Monitorowanie anomalii na topicu '{TOPIC}'...")

user_transactions = defaultdict(deque)

for message in consumer:
    data = message.value
    
    user_id = data.get("user_id")
    timestamp_str = data.get("timestamp")
    
    if not user_id or not timestamp_str:
        continue

    try:
        ts_clean = timestamp_str.replace('Z', '+00:00')
        transaction_time = datetime.fromisoformat(ts_clean)
        
        user_queue = user_transactions[user_id]
        user_queue.append(transaction_time)

        while user_queue and (transaction_time - user_queue[0]).total_seconds() > WINDOW_SECONDS:
            user_queue.popleft()

        if len(user_queue) > THRESHOLD:
            print(f"\n[ALERT] Wykryto anomalię prędkości!")
            print(f"Użytkownik: {user_id}")
            print(f"Liczba transakcji: {len(user_queue)} w czasie {WINDOW_SECONDS}s")
            print(f"Ostatnia transakcja: {data}")
            
    except ValueError as e:
        print(f"Błąd formatu daty: {e}")
        continue
